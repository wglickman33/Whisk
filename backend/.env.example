# Local dev (PostgreSQL — use Docker: docker run --name whisk-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whisk?schema=public"
JWT_SECRET="change-me-in-production"
PORT=3001

# Comma-separated allowed frontend origins
# Production example:
# FRONTEND_URL="https://trywhisk.netlify.app"
FRONTEND_URL="http://localhost:5173,http://localhost:5174"
