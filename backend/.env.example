# Copy to .env and fill in values. Never commit .env.
# Production secrets belong in Heroku config vars.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/whisk?schema=public"
JWT_SECRET="replace-with-long-random-string"
PORT=3001
# Comma-separated - all allowed frontend origins (CORS + reset links)
FRONTEND_URL="https://trywhisk.netlify.app,http://localhost:5173,http://localhost:5174"

# Password reset - EmailJS (https://www.emailjs.com)
# Account → Security → enable API for non-browser applications
# Template variables: to_email, to_name, reset_link
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# Ingredient substitutes - Spoonacular (https://spoonacular.com/food-api)
SPOONACULAR_API_KEY=
